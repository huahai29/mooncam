{
  "name": "mooncam",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Node host and browser shell for the MoonBit MoonCam library",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:integration": "node --test tests/integration.test.mjs tests/export.test.mjs tests/api-contract.test.mjs tests/provenance.test.mjs tests/result-bundle.test.mjs tests/delivery.test.mjs",
    "test:property": "node tests/property.test.mjs",
    "test:consistency": "node tests/consistency.mjs",
    "test:consistency:compare": "node tests/consistency.check.mjs artifacts/consistency",
    "demo": "node bin/mooncam.mjs examples/workshop.json --out artifacts/workshop",
    "serve": "node scripts/serve.mjs",
    "test:oracle": "python tests/oracle.py",
    "test:oracle:highprec": "python tests/oracle_highprec.py",
    "test:browser": "playwright test",
    "test:dxf": "python tests/dxf_interop.py",
    "benchmark": "node tests/benchmark.mjs",
    "docs:contract": "node scripts/contract-docs.mjs",
    "docs:check": "node scripts/contract-docs.mjs --check",
    "performance:check": "node tests/performance-guard.mjs",
    "version:check": "node scripts/version.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "test:consistency:checker": "node --test tests/consistency-check.test.mjs",
    "test:readme": "node tests/readme-numbers.mjs",
    "test:coverage": "node --test tests/coverage-check.test.mjs && node scripts/coverage.mjs",
    "test:sampling": "python tests/sampling_experiment.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
