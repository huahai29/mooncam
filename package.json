{
  "name": "mooncam",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Node host and browser shell for the MoonBit MoonCam library",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:integration": "node --test tests/integration.test.mjs tests/export.test.mjs tests/api-contract.test.mjs",
    "demo": "node bin/mooncam.mjs examples/workshop.json --out artifacts/workshop",
    "serve": "node scripts/serve.mjs",
    "test:oracle": "python tests/oracle.py",
    "test:browser": "playwright test",
    "test:dxf": "python tests/dxf_interop.py",
    "benchmark": "node tests/benchmark.mjs",
    "docs:contract": "node scripts/contract-docs.mjs",
    "docs:check": "node scripts/contract-docs.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
