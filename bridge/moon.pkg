import {
  "huahai29/mooncam" @cam,
}

pkgtype(kind: "executable")

options(
  supported_targets: "js",
  link: {
    "js": {
      "exports": [
        "run",
        "validate_segments",
        "input_limit_bytes",
        "export_profile",
        "contract",
        "error_exit_code",
        "result_exit_code",
      ],
      "format": "esm",
    },
  },
)
